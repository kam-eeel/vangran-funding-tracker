{
  "name": "vangran-funding-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create vangran-funding",
    "db:migrate": "wrangler d1 execute vangran-funding --file=src/db/schema.sql",
